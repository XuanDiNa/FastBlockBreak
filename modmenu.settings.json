{
  "schemaVersion": 1,
  "plugin": {
    "id": "FastBlockBreak",
    "entry": "FastBlockBreak.dll",
    "versions": ["0.2.0-test3"]
  },
  "config": {"file": "config.json", "reload": "hot"},
  "fields": [
    {
